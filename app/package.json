{
  "name": "factory-configurator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:neutral": "tsc --noEmit && VITE_BRAND=neutral vite build --outDir dist-neutral",
    "build:preview": "npm run build:neutral && node scripts/preview-page.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint . && vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "pptxgenjs": "3.12.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vite": "6.4.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "3.2.7"
  }
}
